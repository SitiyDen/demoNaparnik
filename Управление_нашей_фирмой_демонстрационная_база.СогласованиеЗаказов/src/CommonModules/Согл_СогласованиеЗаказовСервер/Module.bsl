КонецФункции

// Возвращает наименование состояния заказа поставщику "В работе".
//
// Возвращаемое значение:
//  Строка - наименование состояния.
//
Функция ИмяСостоянияВРаботе()

	Возврат "В работе";

КонецФункции

// Возвращает данные согласования заказа, необходимые для запроса к YandexGPT.
//
// Параметры:
//  СогласованиеСсылка - ДокументСсылка.Согл_СогласованиеЗаказа - документ согласования.
//
// Возвращаемое значение:
//  Структура - данные заказа:
//   * Поставщик - Строка - представление поставщика.
//   * Сумма - Число - сумма заказа.
//   * РольСогласующего - Строка - представление роли согласующего.
//   * Товары - Массив из Структура - состав заказа (Номенклатура, Количество, Цена).
//
Функция ДанныеЗаказаДляПромпта(СогласованиеСсылка)

	Данные = Новый Структура;
	Данные.Вставить("Поставщик", "");
	Данные.Вставить("Сумма", 0);
	Данные.Вставить("РольСогласующего", "");

	Товары = Новый Массив;
	Данные.Вставить("Товары", Товары);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Согласование.Контрагент КАК Поставщик,
		|	Согласование.СуммаДокумента КАК Сумма,
		|	Согласование.РольСогласующего КАК РольСогласующего
		|ИЗ
		|	Документ.Согл_СогласованиеЗаказа КАК Согласование
		|ГДЕ
		|	Согласование.Ссылка = &Согласование";
	Запрос.УстановитьПараметр("Согласование", СогласованиеСсылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Данные.Поставщик = Строка(Выборка.Поставщик);
		Данные.Сумма = Выборка.Сумма;
		Данные.РольСогласующего = Строка(Выборка.РольСогласующего);
	КонецЕсли;

	ЗапросТовары = Новый Запрос;
	ЗапросТовары.Текст =
		"ВЫБРАТЬ
		|	Товары.Номенклатура КАК Номенклатура,
		|	Товары.Количество КАК Количество,
		|	Товары.Цена КАК Цена
		|ИЗ
		|	Документ.Согл_СогласованиеЗаказа.Товары КАК Товары
		|ГДЕ
		|	Товары.Ссылка = &Согласование
		|
		|УПОРЯДОЧИТЬ ПО
		|	Товары.НомерСтроки";
	ЗапросТовары.УстановитьПараметр("Согласование", СогласованиеСсылка);

	ВыборкаТовары = ЗапросТовары.Выполнить().Выбрать();
	Пока ВыборкаТовары.Следующий() Цикл
		СтрокаТовара = Новый Структура;
		СтрокаТовара.Вставить("Номенклатура", ВыборкаТовары.Номенклатура);
		СтрокаТовара.Вставить("Количество", ВыборкаТовары.Количество);
		СтрокаТовара.Вставить("Цена", ВыборкаТовары.Цена);
		Товары.Добавить(СтрокаТовара);
	КонецЦикла;

	ЗаполнитьНаименованияТоваров(Товары);

	Возврат Данные;

КонецФункции

// Заменяет ссылки на номенклатуру в строках состава заказа их наименованиями.
//
// Параметры:
//  Товары - Массив из Структура - строки состава заказа (Номенклатура, Количество, Цена).
//
Процедура ЗаполнитьНаименованияТоваров(Товары)

	Ссылки = Новый Массив;
	Для Каждого СтрокаТовара Из Товары Цикл
		Если ЗначениеЗаполнено(СтрокаТовара.Номенклатура)
			И Ссылки.Найти(СтрокаТовара.Номенклатура) = Неопределено Тогда
			Ссылки.Добавить(СтрокаТовара.Номенклатура);
		КонецЕсли;
	КонецЦикла;

	Наименования = Новый Соответствие;
	Если Ссылки.Количество() > 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Номенклатура.Ссылка КАК Ссылка,
			|	Номенклатура.Наименование КАК Наименование
			|ИЗ
			|	Справочник.Номенклатура КАК Номенклатура
			|ГДЕ
			|	Номенклатура.Ссылка В (&Ссылки)";
		Запрос.УстановитьПараметр("Ссылки", Ссылки);

		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Наименования.Вставить(Выборка.Ссылка, Выборка.Наименование);
		КонецЦикла;
	КонецЕсли;

	Для Каждого СтрокаТовара Из Товары Цикл
		Наименование = Наименования.Получить(СтрокаТовара.Номенклатура);
		СтрокаТовара.Номенклатура = ?(Наименование = Неопределено, "", Наименование);
	КонецЦикла;

КонецПроцедуры

// Формирует текст запроса к YandexGPT по данным заказа.
//
// Параметры:
//  Данные - Структура - данные заказа, см. ДанныеЗаказаДляПромпта.
//
// Возвращаемое значение:
//  Строка - текст запроса.
//
Функция ТекстДанныхЗаказа(Данные)

	ПределПозиций = 30;

	Части = Новый Массив;
	Части.Добавить("Заказ поставщику.");
	Части.Добавить("Поставщик: "
		+ ?(ЗначениеЗаполнено(Данные.Поставщик), Данные.Поставщик, "не указан") + ".");
	Части.Добавить("Сумма заказа: " + Формат(Данные.Сумма, "ЧДЦ=2; ЧГ=0") + " руб.");
	Части.Добавить("Роль согласующего: "
		+ ?(ЗначениеЗаполнено(Данные.РольСогласующего), Данные.РольСогласующего, "не указана") + ".");

	Если Данные.Товары.Количество() = 0 Тогда
		Части.Добавить("Состав заказа не заполнен.");
	Иначе
		Части.Добавить("Состав заказа:");
		НомерСтроки = 0;
		Для Каждого СтрокаТовара Из Данные.Товары Цикл
			НомерСтроки = НомерСтроки + 1;
			Если НомерСтроки > ПределПозиций Тогда
				Прервать;
			КонецЕсли;
			Части.Добавить(СтрШаблон("%1) %2 - %3 - %4 руб.",
				НомерСтроки,
				СтрокаТовара.Номенклатура,
				Формат(СтрокаТовара.Количество, "ЧДЦ=3; ЧГ=0"),
				Формат(СтрокаТовара.Цена, "ЧДЦ=2; ЧГ=0")));
		КонецЦикла;
		Если Данные.Товары.Количество() > ПределПозиций Тогда
			Части.Добавить(СтрШаблон("... и еще %1 позиций.",
				Данные.Товары.Количество() - ПределПозиций));
		КонецЕсли;
	КонецЕсли;

	Возврат СтрСоединить(Части, Символы.ПС);

