////////////////////////////////////////////////////////////////////////////////
// Согласование заказов поставщику: серверная бизнес-логика расширения.

#Область ПрограммныйИнтерфейс

// Возвращает действующее согласование заказа поставщику.
//
// Параметры:
//  ЗаказСсылка - ДокументСсылка.ЗаказПоставщику - заказ поставщику.
//
// Возвращаемое значение:
//  ДокументСсылка.Согл_СогласованиеЗаказа - действующее согласование, пустая ссылка - согласования нет.
//
Функция ДействующееСогласование(ЗаказСсылка) Экспорт

	Если Не ЗначениеЗаполнено(ЗаказСсылка) Тогда
		Возврат Документы.Согл_СогласованиеЗаказа.ПустаяСсылка();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Состояния.Согласование КАК Согласование
		|ИЗ
		|	РегистрСведений.Согл_СогласованияЗаказов КАК Состояния
		|ГДЕ
		|	Состояния.ЗаказПоставщику = &ЗаказПоставщику";
	Запрос.УстановитьПараметр("ЗаказПоставщику", ЗаказСсылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Согласование;
	КонецЕсли;

	Возврат Документы.Согл_СогласованиеЗаказа.ПустаяСсылка();

КонецФункции

// Возвращает статус действующего согласования заказа поставщику.
//
// Параметры:
//  ЗаказСсылка - ДокументСсылка.ЗаказПоставщику - заказ поставщику.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.Согл_СтатусыСогласования - статус согласования.
//
Функция СтатусСогласования(ЗаказСсылка) Экспорт

	Если Не ЗначениеЗаполнено(ЗаказСсылка) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Состояния.Статус КАК Статус
		|ИЗ
		|	РегистрСведений.Согл_СогласованияЗаказов КАК Состояния
		|ГДЕ
		|	Состояния.ЗаказПоставщику = &ЗаказПоставщику";
	Запрос.УстановитьПараметр("ЗаказПоставщику", ЗаказСсылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Статус;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Возвращает хеш состава заказа, зафиксированный в действующем согласовании.
//
// Параметры:
//  ЗаказСсылка - ДокументСсылка.ЗаказПоставщику - заказ поставщику.
//
// Возвращаемое значение:
//  Строка - хеш состава заказа на момент согласования.
//
Функция ХешСоставаВРегистре(ЗаказСсылка) Экспорт

	Если Не ЗначениеЗаполнено(ЗаказСсылка) Тогда
		Возврат "";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Состояния.ХешСостава КАК ХешСостава
		|ИЗ
		|	РегистрСведений.Согл_СогласованияЗаказов КАК Состояния
		|ГДЕ
		|	Состояния.ЗаказПоставщику = &ЗаказПоставщику";
	Запрос.УстановитьПараметр("ЗаказПоставщику", ЗаказСсылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ХешСостава;
	КонецЕсли;

	Возврат "";

КонецФункции

// Заполняет согласующего и его роль по сумме заказа согласно настраиваемым порогам.
//
// Параметры:
//  Согласование - ДокументОбъект.Согл_СогласованиеЗаказа - заполняемый документ согласования.
//  Сумма - Число - сумма заказа поставщику.
//
Процедура ЗаполнитьСогласующегоПоСумме(Согласование, Сумма) Экспорт

	Согласование.Согласующий = Справочники.Пользователи.ПустаяСсылка();
	Согласование.РольСогласующего = Неопределено;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Правила.Согласующий КАК Согласующий,
		|	Правила.РольСогласующего КАК РольСогласующего
		|ИЗ
		|	РегистрСведений.Согл_ПравилаСогласованияЗаказов КАК Правила
		|ГДЕ
		|	Правила.Действует
		|	И Правила.МинимальнаяСумма <= &Сумма
		|	И (Правила.МаксимальнаяСумма = 0 ИЛИ Правила.МаксимальнаяСумма > &Сумма)
		|УПОРЯДОЧИТЬ ПО
		|	Правила.МинимальнаяСумма УБЫВ,
		|	Правила.Порядок ВОЗР";
	Запрос.УстановитьПараметр("Сумма", Сумма);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Согласование.Согласующий = Выборка.Согласующий;
		Согласование.РольСогласующего = Выборка.РольСогласующего;
	КонецЕсли;

КонецПроцедуры

// Вычисляет хеш состава заказа для отслеживания изменений состава и сумм.
//
// Параметры:
//  ЗаказОбъект - ДокументОбъект.ЗаказПоставщику - заказ поставщику.
//
// Возвращаемое значение:
//  Строка - хеш состава товарной части заказа.
//
Функция КонтрольнаяСуммаИХеш(ЗаказОбъект) Экспорт

	СтрокиСостава = Новый Массив;
	Для Каждого СтрокаЗапасы Из ЗаказОбъект.Запасы Цикл
		СтрокиСостава.Добавить(СтрШаблон("%1|%2|%3|%4|%5",
			Строка(СтрокаЗапасы.Номенклатура),
			Строка(СтрокаЗапасы.Характеристика),
			Формат(СтрокаЗапасы.Количество, "ЧДЦ=3; ЧГ=0"),
			Формат(СтрокаЗапасы.Цена, "ЧДЦ=2; ЧГ=0"),
			Формат(СтрокаЗапасы.Сумма, "ЧДЦ=2; ЧГ=0")));
	КонецЦикла;
	//СтрокиСостава.Сортировать();

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA1);
	Хеширование.Добавить(СтрСоединить(СтрокиСостава, "#"));

	Возврат ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма);

КонецФункции

// Обеспечивает наличие действующего согласования для заказа поставщику.
// Создает согласование при его отсутствии, а при изменении состава или суммы
// заказа сбрасывает текущее согласование и создает новое.
//
// Параметры:
//  ЗаказСсылка - ДокументСсылка.ЗаказПоставщику - заказ поставщику.
//
Процедура ОбеспечитьСогласование(ЗаказСсылка) Экспорт

	Если Не ЗначениеЗаполнено(ЗаказСсылка) Тогда
		Возврат;
	КонецЕсли;

	ЗаказОбъект = ЗаказСсылка.ПолучитьОбъект();
	Если ЗаказОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ХешСостава = КонтрольнаяСуммаИХеш(ЗаказОбъект);
	СогласованиеСсылка = ДействующееСогласование(ЗаказСсылка);

	Если ЗначениеЗаполнено(СогласованиеСсылка) Тогда
		Если СтатусСогласования(ЗаказСсылка) <> Перечисления.Согл_СтатусыСогласования.Сброшен
			И ХешСоставаВРегистре(ЗаказСсылка) = ХешСостава Тогда
			Возврат;
		КонецЕсли;
		СброситьСогласование(СогласованиеСсылка, "Изменен состав или сумма заказа");
	КонецЕсли;

	СоздатьСогласование(ЗаказОбъект, ХешСостава);

КонецПроцедуры

// Переводит согласование в статус "Сброшен" и обновляет регистр состояний.
//
// Параметры:
//  СогласованиеСсылка - ДокументСсылка.Согл_СогласованиеЗаказа - документ согласования.
//  Причина - Строка - причина сброса согласования.
//
Процедура СброситьСогласование(СогласованиеСсылка, Причина = "") Экспорт

	Если Не ЗначениеЗаполнено(СогласованиеСсылка) Тогда
		Возврат;
	КонецЕсли;

	Согласование = СогласованиеСсылка.ПолучитьОбъект();
	Если Согласование = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Согласование.Статус = Перечисления.Согл_СтатусыСогласования.Сброшен;
	Согласование.Согласующий = Справочники.Пользователи.ПустаяСсылка();
	Согласование.РольСогласующего = Неопределено;
	Согласование.ДатаСогласования = Дата(1, 1, 1);
	Согласование.ПричинаСброса = Причина;
	Согласование.Записать();

	ЗаписатьСостояниеВРегистр(Согласование);

КонецПроцедуры

// Устанавливает статус согласования с проверкой прав текущего пользователя.
//
// Параметры:
//  СогласованиеСсылка - ДокументСсылка.Согл_СогласованиеЗаказа - документ согласования.
//  Статус - ПеречислениеСсылка.Согл_СтатусыСогласования - новый статус согласования.
//  Комментарий - Строка - комментарий согласующего.
//
Процедура УстановитьСтатус(СогласованиеСсылка, Статус, Комментарий = "") Экспорт

	Согласование = СогласованиеСсылка.ПолучитьОбъект();
	Если Согласование = Неопределено Тогда
		ВызватьИсключение "Согласование заказа не найдено.";
	КонецЕсли;

	ТекущийПользователь = Пользователи.ТекущийПользователь();
	Если Не ЗначениеЗаполнено(Согласование.Согласующий)
		Или Согласование.Согласующий <> ТекущийПользователь Тогда
		ВызватьИсключение "Установить статус согласования может только назначенный согласующий.";
	КонецЕсли;

	Согласование.Статус = Статус;
	Если Статус = Перечисления.Согл_СтатусыСогласования.Согласован Тогда
		Согласование.ДатаСогласования = ТекущаяДатаСеанса();
	Иначе
		Согласование.ДатаСогласования = Дата(1, 1, 1);
	КонецЕсли;
	Если ЗначениеЗаполнено(Комментарий) Тогда
		Согласование.Комментарий = Комментарий;
	КонецЕсли;
	Согласование.Записать();

	ЗаписатьСостояниеВРегистр(Согласование);

КонецПроцедуры

// Проверяет возможность проведения заказа поставщику.
//
// Параметры:
//  ЗаказОбъект - ДокументОбъект.ЗаказПоставщику - проводимый заказ поставщику.
//
// Возвращаемое значение:
//  Булево - Истина, если проведение заказа разрешено.
//
Функция ПроверитьВозможностьПроведенияЗаказа(ЗаказОбъект) Экспорт

	СостояниеНовый = СостояниеПоНаименованию(ИмяСостоянияНовый());
	Если Не ЗначениеЗаполнено(ЗаказОбъект.СостояниеЗаказа)
		Или (ЗначениеЗаполнено(СостояниеНовый)
			И ЗаказОбъект.СостояниеЗаказа = СостояниеНовый) Тогда
		Возврат Истина;
	КонецЕсли;

	Согласовано = (ЗначениеЗаполнено(ДействующееСогласование(ЗаказОбъект.Ссылка))
		И СтатусСогласования(ЗаказОбъект.Ссылка) = Перечисления.Согл_СтатусыСогласования.Согласован);

	Если Не Согласовано Тогда
		ВывестиСообщение("Заказ поставщику может быть проведен без согласования только в состоянии "
			+ """Новый"". Переведите заказ в состояние ""Новый"" или согласуйте его.");
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции

// Проверяет возможность проведения приходной накладной по заказам поставщику.
//
// Параметры:
//  ДокументОбъект - ДокументОбъект.ПриходнаяНакладная - проводимый документ.
//
// Возвращаемое значение:
//  Булево - Истина, если проведение документа разрешено.
//
Функция ПроверитьВозможностьПроведенияПриходнойНакладной(ДокументОбъект) Экспорт

	Заказы = Новый Массив;
	ДобавитьЗаказПоставщику(Заказы, ДокументОбъект.Заказ);
	ДобавитьЗаказПоставщику(Заказы, ДокументОбъект.ДокументОснование);
	Для Каждого СтрокаЗапасы Из ДокументОбъект.Запасы Цикл
		ДобавитьЗаказПоставщику(Заказы, СтрокаЗапасы.Заказ);
	КонецЦикла;

	Если Заказы.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Результат = Истина;
	СтатусыПоЗаказамДанные = СтатусыПоЗаказам(Заказы);
	СостоянияПоЗаказамДанные = СостоянияЗаказовПоСсылкам(Заказы);
	СсылкиСостояний = СсылкиСостоянийПоНаименованиям();
	СостояниеВРаботе = СсылкиСостояний.Получить(ИмяСостоянияВРаботе());

	Для Каждого ЗаказСсылка Из Заказы Цикл

		Согласован = (СтатусыПоЗаказамДанные.Получить(ЗаказСсылка)
			= Перечисления.Согл_СтатусыСогласования.Согласован);

		СостояниеЗаказа = СостоянияПоЗаказамДанные.Получить(ЗаказСсылка);
		ВРаботе = (ЗначениеЗаполнено(СостояниеЗаказа)
			И ЗначениеЗаполнено(СостояниеВРаботе)
			И СостояниеЗаказа = СостояниеВРаботе);

		Если Не Согласован Или Не ВРаботе Тогда
			Результат = Ложь;
			ВывестиСообщение("Проведение приходной накладной по заказу поставщику "
				+ Строка(ЗаказСсылка) + " возможно только после согласования заказа "
				+ "и перевода его в состояние ""В работе"".");
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Формирует резюме заказа поставщику с помощью YandexGPT и записывает его в комментарий согласования.
//
// Параметры:
//  СогласованиеСсылка - ДокументСсылка.Согл_СогласованиеЗаказа - документ согласования.
//
// Возвращаемое значение:
//  Структура - результат формирования резюме:
//   * Успех - Булево - Истина, если резюме сформировано и записано.
//   * Текст - Строка - текст резюме.
//   * ОписаниеОшибки - Строка - описание ошибки, если Успех = Ложь.
//
Функция СформироватьРезюмеЗаказа(СогласованиеСсылка) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Текст", "");
	Результат.Вставить("ОписаниеОшибки", "");

	Если Не ЗначениеЗаполнено(СогласованиеСсылка) Тогда
		Результат.ОписаниеОшибки = "Согласование заказа не найдено.";
		Возврат Результат;
	КонецЕсли;

	Ответ = Согл_YandexGPT.ЗапросКМодели(ТекстДанныхЗаказа(ДанныеЗаказаДляПромпта(СогласованиеСсылка)));
	Результат.Текст = Ответ.Текст;
	Если Не Ответ.Успех Тогда
		Результат.ОписаниеОшибки = Ответ.ОписаниеОшибки;
		Возврат Результат;
	КонецЕсли;

	Согласование = СогласованиеСсылка.ПолучитьОбъект();
	Если Согласование = Неопределено Тогда
		Результат.ОписаниеОшибки = "Не удалось прочитать документ согласования заказа.";
		Возврат Результат;
	КонецЕсли;

	Согласование.Комментарий = Ответ.Текст;
	Согласование.Записать();

	Результат.Успех = Истина;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Обработчик подписки ПриЗаписи документа "Заказ поставщику".
//
// Параметры:
//  Источник - ДокументОбъект.ЗаказПоставщику - записываемый документ.
//  Отказ - Булево - признак отказа от записи документа.
//
Процедура Согл_ЗаказПоставщикуПриЗаписи(Источник, Отказ) Экспорт

	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ОбеспечитьСогласование(Источник.Ссылка);
	Исключение
		ЗаписьЖурналаРегистрации("Согласование заказов.ПриЗаписи",
			УровеньЖурналаРегистрации.Ошибка, ,
			Источник.Ссылка,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// Обработчик подписки ОбработкаПроведения документа "Заказ поставщику".
//
// Параметры:
//  Источник - ДокументОбъект.ЗаказПоставщику - проводимый документ.
//  Отказ - Булево - признак отказа в проведении документа.
//
Процедура Согл_ЗаказПоставщикуОбработкаПроведения(Источник, Отказ) Экспорт

	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если Не ПроверитьВозможностьПроведенияЗаказа(Источник) Тогда
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

// Обработчик подписки ОбработкаПроведения документа "Приходная накладная".
//
// Параметры:
//  Источник - ДокументОбъект.ПриходнаяНакладная - проводимый документ.
//  Отказ - Булево - признак отказа в проведении документа.
//
Процедура Согл_ПриходнаяНакладнаяОбработкаПроведения(Источник, Отказ) Экспорт

	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если Не ПроверитьВозможностьПроведенияПриходнойНакладной(Источник) Тогда
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Создает документ согласования по заказу поставщику и фиксирует его состояние.
//
// Параметры:
//  ЗаказОбъект - ДокументОбъект.ЗаказПоставщику - заказ поставщику.
//  ХешСостава - Строка - хеш состава заказа на момент создания согласования.
//
// Возвращаемое значение:
//  ДокументСсылка.Согл_СогласованиеЗаказа - созданное согласование.
//
Функция СоздатьСогласование(ЗаказОбъект, ХешСостава)

	Согласование = Документы.Согл_СогласованиеЗаказа.СоздатьДокумент();
	Согласование.Дата = ТекущаяДатаСеанса();
	Согласование.ЗаказПоставщику = ЗаказОбъект.Ссылка;
	Согласование.Менеджер = ЗаказОбъект.Ответственный;
	Согласование.Контрагент = ЗаказОбъект.Контрагент;
	Согласование.Организация = ЗаказОбъект.Организация;
	Согласование.СуммаДокумента = ЗаказОбъект.СуммаДокумента;

	ЗаполнитьСогласующегоПоСумме(Согласование, ЗаказОбъект.СуммаДокумента);

	Согласование.Статус = Перечисления.Согл_СтатусыСогласования.ОжидаетСогласования;

	Для Каждого СтрокаЗапасы Из ЗаказОбъект.Запасы Цикл
		НоваяСтрока = Согласование.Товары.Добавить();
		НоваяСтрока.Номенклатура = СтрокаЗапасы.Номенклатура;
		НоваяСтрока.Характеристика = СтрокаЗапасы.Характеристика;
		НоваяСтрока.Количество = СтрокаЗапасы.Количество;
		НоваяСтрока.Цена = СтрокаЗапасы.Цена;
		НоваяСтрока.Сумма = СтрокаЗапасы.Сумма;
	КонецЦикла;

	Согласование.Записать();

	ЗаписатьСостояниеВРегистр(Согласование, ХешСостава);

	Если Не ЗначениеЗаполнено(Согласование.Согласующий) Тогда
		ВывестиСообщение("Для заказа поставщику " + Строка(ЗаказОбъект.Ссылка)
			+ " не найден согласующий: не заполнены правила согласования заказов.");
	КонецЕсли;

	Возврат Согласование.Ссылка;

КонецФункции

// Записывает текущее состояние согласования в регистр сведений.
//
// Параметры:
//  Согласование - ДокументОбъект.Согл_СогласованиеЗаказа - документ согласования.
//  ХешСостава - Строка - хеш состава заказа, пустая строка - рассчитать по заказу.
//
Процедура ЗаписатьСостояниеВРегистр(Согласование, ХешСостава = "")

	ТекущийХеш = ХешСостава;
	Если Не ЗначениеЗаполнено(ТекущийХеш) И ЗначениеЗаполнено(Согласование.ЗаказПоставщику) Тогда
		ЗаказОбъект = Согласование.ЗаказПоставщику.ПолучитьОбъект();
		Если ЗаказОбъект <> Неопределено Тогда
			ТекущийХеш = КонтрольнаяСуммаИХеш(ЗаказОбъект);
		КонецЕсли;
	КонецЕсли;

	НаборЗаписей = РегистрыСведений.Согл_СогласованияЗаказов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ЗаказПоставщику.Установить(Согласование.ЗаказПоставщику);

	Запись = НаборЗаписей.Добавить();
	Запись.ЗаказПоставщику = Согласование.ЗаказПоставщику;
	Запись.Согласование = Согласование.Ссылка;
	Запись.Согласующий = Согласование.Согласующий;
	Запись.Статус = Согласование.Статус;
	Запись.ДатаСогласования = Согласование.ДатаСогласования;
	Запись.КонтрольнаяСумма = Согласование.СуммаДокумента;
	Запись.ХешСостава = ТекущийХеш;

	НаборЗаписей.Записать(Истина);

КонецПроцедуры

// Добавляет в массив заказ поставщику, если он еще не добавлен.
//
// Параметры:
//  Заказы - Массив из ДокументСсылка.ЗаказПоставщику - накопительный массив ссылок.
//  Значение - Произвольный - проверяемое значение, может быть ссылкой другого типа.
//
Процедура ДобавитьЗаказПоставщику(Заказы, Значение)

	Если ТипЗнч(Значение) = Тип("ДокументСсылка.ЗаказПоставщику")
		И Заказы.Найти(Значение) = Неопределено Тогда
		Заказы.Добавить(Значение);
	КонецЕсли;

КонецПроцедуры

// Возвращает состояния заказов поставщику по указанным заказам.
//
// Параметры:
//  Заказы - Массив из ДокументСсылка.ЗаказПоставщику - заказы поставщику.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - соответствие ссылки на заказ и его состояния.
//
Функция СостоянияЗаказовПоСсылкам(Заказы)

	Результат = Новый Соответствие;
	Если Заказы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Заказы.Ссылка КАК Ссылка,
		|	Заказы.СостояниеЗаказа КАК СостояниеЗаказа
		|ИЗ
		|	Документ.ЗаказПоставщику КАК Заказы
		|ГДЕ
		|	Заказы.Ссылка В (&Заказы)";
	Запрос.УстановитьПараметр("Заказы", Заказы);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка, Выборка.СостояниеЗаказа);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает статусы согласования по указанным заказам поставщику.
//
// Параметры:
//  Заказы - Массив из ДокументСсылка.ЗаказПоставщику - заказы поставщику.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - соответствие ссылки на заказ и статуса его согласования.
//
Функция СтатусыПоЗаказам(Заказы)

	Результат = Новый Соответствие;
	Если Заказы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Состояния.ЗаказПоставщику КАК ЗаказПоставщику,
		|	Состояния.Статус КАК Статус
		|ИЗ
		|	РегистрСведений.Согл_СогласованияЗаказов КАК Состояния
		|ГДЕ
		|	Состояния.ЗаказПоставщику В (&Заказы)";
	Запрос.УстановитьПараметр("Заказы", Заказы);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.ЗаказПоставщику, Выборка.Статус);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает ссылки на состояния заказов поставщику по наименованиям.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - соответствие наименования состояния и ссылки на состояние.
//
Функция СсылкиСостоянийПоНаименованиям()

	Наименования = Новый Массив;
	Наименования.Добавить(ИмяСостоянияНовый());
	Наименования.Добавить(ИмяСостоянияВРаботе());

	Результат = Новый Соответствие;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Состояния.Ссылка КАК Ссылка,
		|	Состояния.Наименование КАК Наименование
		|ИЗ
		|	Справочник.СостоянияЗаказовПоставщикам КАК Состояния
		|ГДЕ
		|	Состояния.Наименование В (&Наименования)
