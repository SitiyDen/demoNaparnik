КонецФункции

// Возвращает ссылку на состояние заказа поставщику по наименованию.
//
// Параметры:
//  Наименование - Строка - наименование состояния.
//
// Возвращаемое значение:
//  СправочникСсылка.СостоянияЗаказовПоставщикам, Неопределено - найденное состояние.
//
Функция СостояниеПоНаименованию(Наименование)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Состояния.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СостоянияЗаказовПоставщикам КАК Состояния
		|ГДЕ
		|	Состояния.Наименование = &Наименование
		|	И НЕ Состояния.ПометкаУдаления";
	Запрос.УстановитьПараметр("Наименование", Наименование);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Возвращает наименование состояния заказа поставщику "Новый".
//
