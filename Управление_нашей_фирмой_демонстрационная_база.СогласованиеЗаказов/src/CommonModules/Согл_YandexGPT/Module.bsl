////////////////////////////////////////////////////////////////////////////////
// Клиент к YandexGPT (Yandex Cloud Foundation Models): генерация текста по запросу.

#Область ПрограммныйИнтерфейс

// Отправляет текстовый запрос в YandexGPT и возвращает ответ модели.
//
// Параметры:
//  ТекстПользователя - Строка - текст запроса (данные заказа).
//
// Возвращаемое значение:
//  Структура - результат запроса:
//   * Успех - Булево - Истина, если ответ модели получен.
//   * Текст - Строка - текст ответа модели.
//   * ОписаниеОшибки - Строка - описание ошибки, если Успех = Ложь.
//
Функция ЗапросКМодели(ТекстПользователя) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Текст", "");
	Результат.Вставить("ОписаниеОшибки", "");

	Параметры = ПараметрыПодключения();
	Если Не ЗначениеЗаполнено(Параметры.КлючAPI)
		Или Не ЗначениеЗаполнено(Параметры.ИдентификаторКаталога) Тогда
		Результат.ОписаниеОшибки =
			"Не заполнены настройки подключения к YandexGPT. Укажите ключ API и идентификатор каталога "
			+ "в константах ""Ключ API YandexGPT"" и ""Идентификатор каталога Yandex Cloud"".";
		Возврат Результат;
	КонецЕсли;

	Попытка
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL();
		Соединение = Новый HTTPСоединение(Параметры.Сервер, Параметры.Порт, , , ,
			Параметры.Таймаут, ЗащищенноеСоединение);
		Запрос = Новый HTTPЗапрос(Параметры.Ресурс, ЗаголовкиЗапроса(Параметры));
		Запрос.УстановитьТелоИзСтроки(ТелоЗапроса(Параметры, ТекстПользователя),
			КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		СтрокаОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);

		Если Ответ.КодСостояния <> 200 Тогда
			Результат.ОписаниеОшибки = СтрШаблон("Сервис YandexGPT вернул код %1: %2",
				Ответ.КодСостояния, ТекстОшибкиИзОтвета(СтрокаОтвета));
			ЗаписатьОшибкуВЖурнал(Результат.ОписаниеОшибки);
			Возврат Результат;
		КонецЕсли;

		ТекстОтвета = ТекстИзОтвета(СтрокаОтвета);
		Если Не ЗначениеЗаполнено(ТекстОтвета) Тогда
			Результат.ОписаниеОшибки = "Сервис YandexGPT вернул ответ без текста.";
			ЗаписатьОшибкуВЖурнал(Результат.ОписаниеОшибки + " Ответ сервиса: " + СтрокаОтвета);
			Возврат Результат;
		КонецЕсли;

		Результат.Успех = Истина;
		Результат.Текст = ТекстОтвета;
	Исключение
		Результат.ОписаниеОшибки = СтрШаблон("Не удалось обратиться к сервису YandexGPT: %1",
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписатьОшибкуВЖурнал(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает параметры подключения к сервису и параметры генерации.
//
// Возвращаемое значение:
//  Структура - параметры запроса:
//   * Сервер - Строка - хост сервиса.
//   * Порт - Число - порт сервиса.
//   * Ресурс - Строка - путь ресурса запроса.
//   * Модель - Строка - идентификатор модели.
//   * Температура - Число - температура генерации.
//   * МаксимумТокенов - Строка - ограничение длины ответа.
//   * Таймаут - Число - таймаут соединения в секундах.
//   * СистемныйПромпт - Строка - системная инструкция модели.
//   * КлючAPI - Строка - ключ API сервисного аккаунта.
//   * ИдентификаторКаталога - Строка - идентификатор каталога Yandex Cloud.
//
Функция ПараметрыПодключения()

	Параметры = Новый Структура;
	Параметры.Вставить("Сервер", "llm.api.cloud.yandex.net");
	Параметры.Вставить("Порт", 443);
	Параметры.Вставить("Ресурс", "/foundationModels/v1/completion");
	Параметры.Вставить("Модель", "yandexgpt-lite/latest");
	Параметры.Вставить("Температура", 0.3);
	Параметры.Вставить("МаксимумТокенов", "500");
	Параметры.Вставить("Таймаут", 30);
	Параметры.Вставить("СистемныйПромпт",
		"Ты помощник руководителя. Кратко, в 2-3 предложениях, опиши заказ для руководителя.");
	Параметры.Вставить("КлючAPI", "");
	Параметры.Вставить("ИдентификаторКаталога", "");

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Параметры.КлючAPI = СокрЛП(Константы.Согл_YandexGPTКлючAPI.Получить());
		Параметры.ИдентификаторКаталога = СокрЛП(Константы.Согл_YandexGPTКаталог.Получить());
	Исключение
		ЗаписатьОшибкуВЖурнал("Не удалось прочитать настройки подключения к YandexGPT: "
			+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Параметры;

КонецФункции

// Возвращает заголовки HTTP-запроса к сервису.
//
// Параметры:
//  Параметры - Структура - параметры подключения.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение - заголовки запроса.
//
Функция ЗаголовкиЗапроса(Параметры)

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Api-Key " + Параметры.КлючAPI);
	Заголовки.Вставить("x-folder-id", Параметры.ИдентификаторКаталога);
	Заголовки.Вставить("Content-Type", "application/json");
	Заголовки.Вставить("Accept", "application/json");

	Возврат Заголовки;

КонецФункции

// Формирует тело запроса к сервису в формате JSON.
//
// Параметры:
//  Параметры - Структура - параметры подключения.
//  ТекстПользователя - Строка - текст запроса (данные заказа).
//
// Возвращаемое значение:
//  Строка - тело запроса.
//
Функция ТелоЗапроса(Параметры, ТекстПользователя)

	ОпцииЗавершения = Новый Структура;
	ОпцииЗавершения.Вставить("stream", Ложь);
	ОпцииЗавершения.Вставить("temperature", Параметры.Температура);
	ОпцииЗавершения.Вставить("maxTokens", Параметры.МаксимумТокенов);

	СистемноеСообщение = Новый Структура;
	СистемноеСообщение.Вставить("role", "system");
	СистемноеСообщение.Вставить("text", Параметры.СистемныйПромпт);

	СообщениеПользователя = Новый Структура;
	СообщениеПользователя.Вставить("role", "user");
	СообщениеПользователя.Вставить("text", ТекстПользователя);

	Сообщения = Новый Массив;
	Сообщения.Добавить(СистемноеСообщение);
	Сообщения.Добавить(СообщениеПользователя);

	Тело = Новый Структура;
	Тело.Вставить("modelUri", СтрШаблон("gpt://%1/%2", Параметры.ИдентификаторКаталога, Параметры.Модель));
	Тело.Вставить("completionOptions", ОпцииЗавершения);
	Тело.Вставить("messages", Сообщения);

	Возврат ЗаписатьЗначениеJSON(Тело);

КонецФункции

// Извлекает текст ответа модели из JSON-ответа сервиса.
//
// Параметры:
//  СтрокаОтвета - Строка - тело ответа сервиса.
//
// Возвращаемое значение:
//  Строка - текст ответа модели, пустая строка - если текст не найден.
//
Функция ТекстИзОтвета(СтрокаОтвета)

	Попытка
		Данные = ПрочитатьЗначениеJSON(СтрокаОтвета);
	Исключение
		Возврат "";
	КонецПопытки;

	Если ТипЗнч(Данные) <> Тип("Структура") Или Не Данные.Свойство("result") Тогда
		Возврат "";
	КонецЕсли;

	РезультатЗапроса = Данные["result"];
	Если ТипЗнч(РезультатЗапроса) <> Тип("Структура")
		Или Не РезультатЗапроса.Свойство("alternatives") Тогда
		Возврат "";
	КонецЕсли;

	Альтернативы = РезультатЗапроса["alternatives"];
	Если ТипЗнч(Альтернативы) <> Тип("Массив") Или Альтернативы.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Альтернатива = Альтернативы[0];
	Если ТипЗнч(Альтернатива) <> Тип("Структура")
		Или Не Альтернатива.Свойство("message") Тогда
		Возврат "";
	КонецЕсли;

	Сообщение = Альтернатива["message"];
	Если ТипЗнч(Сообщение) <> Тип("Структура") Или Не Сообщение.Свойство("text") Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрЛП(Сообщение["text"]);

КонецФункции

// Извлекает описание ошибки из JSON-ответа сервиса.
//
// Параметры:
//  СтрокаОтвета - Строка - тело ответа сервиса.
//
// Возвращаемое значение:
//  Строка - описание ошибки.
//
Функция ТекстОшибкиИзОтвета(СтрокаОтвета)

	Если Не ЗначениеЗаполнено(СтрокаОтвета) Тогда
		Возврат "пустой ответ";
	КонецЕсли;

	Попытка
		Данные = ПрочитатьЗначениеJSON(СтрокаОтвета);
	Исключение
		Возврат СтрШаблон("не удалось разобрать ответ: %1", Лев(СтрокаОтвета, 500));
	КонецПопытки;

	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("error") Тогда
		Ошибка = Данные.error;
		Если ТипЗнч(Ошибка) = Тип("Структура") И Ошибка.Свойство("message") Тогда
			Возврат СокрЛП(Ошибка.message);
		КонецЕсли;
	КонецЕсли;

	Возврат Лев(СтрокаОтвета, 500);

КонецФункции

// Записывает сообщение об ошибке в журнал регистрации.
//
// Параметры:
//  Текст - Строка - текст сообщения.
//
Процедура ЗаписатьОшибкуВЖурнал(Текст)

	ЗаписьЖурналаРегистрации("Согласование заказов.YandexGPT",
		УровеньЖурналаРегистрации.Ошибка, , , Текст);

КонецПроцедуры

#КонецОбласти
