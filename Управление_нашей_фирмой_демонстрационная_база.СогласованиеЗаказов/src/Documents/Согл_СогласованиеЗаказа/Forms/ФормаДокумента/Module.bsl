#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ОбновитьДоступностьКоманд();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Согласовать(Команда)

	УстановитьСтатус("Согласован");

КонецПроцедуры

&НаКлиенте
Процедура Отклонить(Команда)

	УстановитьСтатус("Отклонен");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьСтатус(ИмяСтатуса)

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	Статус = ПредопределенноеЗначение("Перечисление.Согл_СтатусыСогласования." + ИмяСтатуса);
	Попытка
		Согл_СогласованиеЗаказовВызовСервера.УстановитьСтатус(Объект.Ссылка, Статус, Объект.Комментарий);
	Исключение
		ПоказатьПредупреждение(, ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	ПеречитатьОбъект();

КонецПроцедуры

&НаСервере
Процедура ПеречитатьОбъект()

	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.Прочитать();
	КонецЕсли;
	ОбновитьДоступностьКоманд();

КонецПроцедуры

&НаСервере
Процедура ОбновитьДоступностьКоманд()

	Доступно = ВозможностьСогласования();
	Элементы.КнопкаСогласовать.Видимость = Доступно;
	Элементы.КнопкаОтклонить.Видимость = Доступно;

КонецПроцедуры

&НаСервере
Функция ВозможностьСогласования()

	Возврат ЗначениеЗаполнено(Объект.Согласующий)
		И Объект.Согласующий = Пользователи.ТекущийПользователь()
		И (Объект.Статус = Перечисления.Согл_СтатусыСогласования.ОжидаетСогласования
			Или Не ЗначениеЗаполнено(Объект.Статус));

КонецФункции

#КонецОбласти
